# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

**.geojson

perf.data*

# Suggested paths for data and index
data/
index/

# wasm-bindgen CLI output, regenerated from airmail_wasm's compiled .wasm
# (see airmail_wasm/test/node_test.cjs for how to regenerate)
airmail_wasm/pkg-node/
airmail_wasm/pkg/
